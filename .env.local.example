# Supabase project settings (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only. Used to encrypt user-provided OpenAI API keys before
# they are stored. Generate one with: openssl rand -base64 32
ENCRYPTION_KEY=

# Server-side only. Fallback OpenAI key used until per-user keys (Settings
# page) are wired up to real storage.
OPENAI_API_KEY=
